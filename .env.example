# Databricks Configuration (Production)
# Uncomment and fill these when connecting to real Databricks workspace
# DATABRICKS_WORKSPACE_URL=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=your_access_token_here
# DATABRICKS_CATALOG=your_catalog
# DATABRICKS_SCHEMA=your_schema
# DATABRICKS_TABLE=training_data

# Simulation Mode (Default for Portfolio Demo)
USE_SIMULATED_DATA=true
SAMPLE_DATA_SIZE=1000

# Model Configuration
BASE_MODEL_NAME=distilgpt2
MAX_SEQ_LENGTH=512
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.1

# Training Configuration
TRAIN_BATCH_SIZE=4
EVAL_BATCH_SIZE=8
GRADIENT_ACCUMULATION_STEPS=4
LEARNING_RATE=2e-4
NUM_EPOCHS=3
WARMUP_STEPS=100
SAVE_STEPS=500
EVAL_STEPS=250
LOGGING_STEPS=50

# Experiment Tracking
# Choose one: mlflow or wandb
EXPERIMENT_TRACKER=mlflow
MLFLOW_TRACKING_URI=sqlite:///monitoring/mlflow.db
MLFLOW_EXPERIMENT_NAME=enterprise-sft-pipeline

# Weights & Biases (optional)
# WANDB_PROJECT=enterprise-sft-pipeline
# WANDB_ENTITY=your_username
# WANDB_MODE=offline  # Set to 'online' when you want to sync

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
DEFAULT_MODEL_VERSION=latest

# Model Registry
MODEL_REGISTRY_DB=sqlite:///monitoring/metrics.db
MODEL_CHECKPOINT_DIR=./models/checkpoints

# Monitoring
LOG_LEVEL=INFO
ENABLE_METRICS_LOGGING=true
METRICS_DB_PATH=monitoring/metrics.db

# Resource Limits (for CPU training)
MAX_WORKERS=4
DEVICE=cpu  # Change to 'cuda' if GPU available

# Evaluation
EVAL_DATASET_PATH=evaluation/eval_dataset.json
MIN_EVAL_SAMPLES=100
GENERATE_MAX_LENGTH=128
GENERATION_TEMPERATURE=0.7
GENERATION_TOP_P=0.9

# Cost Tracking (for portfolio demonstration)
INFERENCE_COST_PER_1K_TOKENS=0.0001  # Simulated cost for fine-tuned model
BASELINE_COST_PER_1K_TOKENS=0.03     # Simulated GPT-4 cost for comparison
